[Unit]
Description=Build ClickHouse master once a day at midnight
Documentation=man:systemd.timer(5)

[Timer]
Unit=clickhouse-master-build.service

# Once a day at 00:00 local time.
OnCalendar=*-*-* 00:00:00

# If the laptop was asleep or off at midnight, run once on wake instead
# of silently missing the day.
Persistent=true

# Do not start exactly on the stroke of midnight together with
# everything else that is scheduled daily.
RandomizedDelaySec=10min

# Let systemd move the start to a moment the machine is already busy.
AccuracySec=1min

[Install]
WantedBy=timers.target
