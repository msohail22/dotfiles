# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status

[init]
	defaultBranch = master

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	tool = nvimdiff

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	features = matteblack

[delta "matteblack"]
	# Mirrors the matteblack.nvim palette: near-black, amber chrome, teal adds,
	# and crimson removals.
	syntax-theme = Monokai Extended
	commit-decoration-style = "bold #F59E0B box ul"
	file-style = "bold #EAEAEA ul"
	file-decoration-style = none
	hunk-header-style = "#F59E0B"
	hunk-header-decoration-style = "#F59E0B box"
	minus-style = "syntax #2B1212"
	minus-emph-style = "syntax #5A1717"
	plus-style = "syntax #0E2D25"
	plus-emph-style = "syntax #0E5C48"
	line-numbers-left-style = "#A3A3A3"
	line-numbers-right-style = "#A3A3A3"
	line-numbers-minus-style = "#DC2626"
	line-numbers-plus-style = "#10B981"
	zero-style = "#8A8A8D"

[commit]
	verbose = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rerere]
	enabled = true
	autoupdate = true

[user]
	name = Mohammed Sohail
	email = mohd.sohail.biz@gmail.com

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[difftool "vimdiff"]
	cmd = vim -d \"$LOCAL\" \"$REMOTE\"

[difftool]
	prompt = true

[merge]
	tool = nvimdiff

[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c \"wincmd w\" -c \"wincmd J\"

[mergetool "vimdiff"]
	cmd = vim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c \"wincmd w\" -c \"wincmd J\"

[mergetool]
	keepBackup = false
